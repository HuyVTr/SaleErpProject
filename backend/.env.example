# Chuỗi kết nối PostgreSQL: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:mat-khau-cua-ban@127.0.0.1:5432/hizogroup?schema=public"

# Cổng chạy server
PORT=5000

# Khóa bí mật ký JWT (đổi thành chuỗi ngẫu nhiên dài, bí mật)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="doi-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien"
JWT_EXPIRES_IN="1h"

# Khóa bí mật ký Refresh Token (PHẢI khác JWT_SECRET, dùng lệnh tương tự để tạo)
JWT_REFRESH_SECRET="doi-thanh-mot-chuoi-bi-mat-khac-that-dai-va-ngau-nhien"
# Thời hạn refresh token: rút ngắn xuống 2 ngày để giảm cửa sổ rủi ro khi token bị lộ
JWT_REFRESH_EXPIRES_IN="2d"

# Cho phép FE gọi API từ origin này
CLIENT_URL="http://localhost:5173"
